{
  "name": "ecofactory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:physics": "esbuild tests/physics.ts --bundle --platform=node --log-level=warning --outfile=tests/.build/physics.cjs && node tests/.build/physics.cjs",
    "test:puzzles": "esbuild tests/puzzles.ts --bundle --platform=node --log-level=warning --outfile=tests/.build/puzzles.cjs && node tests/.build/puzzles.cjs",
    "typecheck:tests": "tsc -p tests"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
